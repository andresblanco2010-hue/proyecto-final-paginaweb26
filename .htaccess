
# =====================================
# GYM SUPPLEMENTS
# CONFIGURACION DE RUTAS
# =====================================

DirectoryIndex index.html

Options -Indexes

<IfModule mod_rewrite.c>

    RewriteEngine On

    # No modificar archivos ni carpetas existentes
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # INICIO
    RewriteRule ^inicio/?$ index.html [L,NC]

    # NUTRICION
    RewriteRule ^nutricion/?$ page/nutricion.html [L,NC]

    # ENTRENAMIENTO
    RewriteRule ^entrenamiento/?$ page/entrenamiento.html [L,NC]

    # DEPORTE
    RewriteRule ^deporte/?$ page/deporte.html [L,NC]

    # SALUD
    RewriteRule ^salud/?$ page/salud.html [L,NC]

    # CONTACTO
    RewriteRule ^contacto/?$ page/contactame.html [L,NC]

</IfModule>
